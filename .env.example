# ---- Runtime
NODE_ENV=development              # development | staging | production
API_PORT=3001
WEB_URL=http://localhost:3000
API_URL=http://localhost:3001

# ---- Supabase
# local  -> talk to `bun run supabase:start` (Docker, no real project needed).
#           Leave the four fields below blank and they fall back to the fixed
#           `supabase start` credentials automatically (see packages/config/src/env.ts).
# cloud  -> talk to a real Supabase project. All four fields below become
#           mandatory; boot fails loudly if any is missing (R11).
SUPABASE_MODE=local

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # API only. NEVER expose to web.

# Direct Postgres connection (Supabase → Settings → Database → Connection string).
# Required because supabase-js cannot run multi-statement transactions and R2
# demands payment + ticket issuance commit atomically. Used by db/transaction.ts.
# Local default (auto-applied when blank): postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_URL=

# ---- Auth (R8: two distinct secrets)
# In SUPABASE_MODE=local, set JWT_SECRET to the fixed local Supabase secret
# (super-secret-jwt-token-with-at-least-32-characters-long) so that a future
# RLS-scoped call (supabaseAsUser) verifies against the local PostgREST/GoTrue
# instance. Not required until that path is wired to a route — see README note.
JWT_SECRET=                       # min 32 chars
QR_JWT_SECRET=                    # min 32 chars, MUST differ from JWT_SECRET
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
QR_TOKEN_TTL=24h

# ---- Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Email (Resend)
RESEND_API_KEY=

# ---- Mapbox
NEXT_PUBLIC_MAPBOX_TOKEN=

# ---- Redis
REDIS_URL=redis://localhost:6379

# ---- Business rules (tunable without code change)
RESERVATION_TTL_MINUTES=10
MAX_TICKETS_PER_USER_PER_EVENT=10
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
API_RATE_LIMIT_PER_MINUTE=100
